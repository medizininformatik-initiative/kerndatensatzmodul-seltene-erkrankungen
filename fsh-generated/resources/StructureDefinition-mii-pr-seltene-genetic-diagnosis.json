  "version": "2027.0.0-ballot.rc1",
  "name": "MII_PR_Seltene_GeneticDiagnosis",
  "title": "MII PR SE Genetic Diagnosis",
  "status": "active",
  "publisher": "Medizininformatik Initiative",
  "contact": [
    {
      "telecom": [
        {
          "system": "url",
