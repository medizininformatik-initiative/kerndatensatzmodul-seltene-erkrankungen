        "short": "Environmental factors (e): extent to which the factor acts as a barrier",
        "min": 0,
        "max": "1",
        "mustSupport": true
      },
      {
        "id": "Observation.component:barrier.code",
        "path": "Observation.component.code",
        "patternCodeableConcept": {
          "coding": [
